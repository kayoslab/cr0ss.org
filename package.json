    "contentful-management": "^12.18.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.47.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.8.1",
